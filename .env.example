# Copy to .env and set a value. .env is gitignored; this example is not.
#
# Read by docker-compose.yml. Compose fails with an instruction rather than
# starting on a default, because a password committed to a repo stays in its
# history forever and only rotation revokes it.
#
# Not needed for the portable-Postgres stopgap that is actually in use here
# (see "No-Docker stopgap" in 03_Local_Cache/Local_Deployment.md) — that path
# reads the password from %APPDATA%\postgresql\pgpass.conf instead.
POSTGRES_PASSWORD=

# Optional. Overrides the whole DSN for the Python entry points. Leave unset
# and they use postgresql://rted@127.0.0.1:5432/aussie_health, resolving the
# password from pgpass.conf.
# DATABASE_URL=postgresql://rted@127.0.0.1:5432/aussie_health
